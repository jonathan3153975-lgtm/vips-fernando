{
  "name": "importcontrol/importcontrol",
  "description": "ImportControl SaaS para gestao de importacoes, estoque, vendas e financeiro.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Database\\": "database/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public public/index.php",
    "test": "phpunit",
    "migrate": "php database/migrate.php",
    "seed": "php database/seed.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}