APP_NAME=ImportControl
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=importcontrol
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=30
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

LOG_PATH=
LOG_LEVEL=debug

# Envio de e-mail. Ainda nao ha integracao implementada (P2 da Etapa 2.2);
# os valores ficam reservados aqui para quando o servidor SMTP for configurado.
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@importcontrol.local
MAIL_FROM_NAME="ImportControl"
